\name{transfer}
\alias{transfer}
\title{Transfer money}
\description{Transfer money from one account to another}
\usage{
transfer(from_account, to_account, amount)
}
\arguments{
  \item{from_account}{Account where money is coming from}
  \item{to_account}{Account where the money is going to}
  \item{amount}{Amount of money to be transferred}
}
\examples{
transfer(checking, saving, 350)
}
